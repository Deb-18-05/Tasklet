// ============================================================
// FULL FILTER REBUILD
//
// This ONLY happens when the search query changes.
// It does NOT happen every second.
// ============================================================

static void rebuild_filtered_view()
{
    uint32_t selectedPid =
        get_selected_pid();

    SendMessageW(
        g_list,
        WM_SETREDRAW,
        FALSE,
        0
    );

    SendMessageW(
        g_list,
        LVM_DELETEALLITEMS,
        0,
        0
    );

    g_rows.clear();

    std::wstring query =
        get_search_text();

    int row = 0;

    for (const auto& process : g_processes)
    {
        if (!matches_search(
                process,
                query))
        {
            continue;
        }

        int inserted =
            list_insert(
                row,
                to_wide(process.name)
            );

        if (inserted < 0)
            continue;

        update_row(
            inserted,
            process
        );

        g_rows[process.pid] =
            inserted;

        ++row;
    }

    SendMessageW(
        g_list,
        WM_SETREDRAW,
        TRUE,
        0
    );

    InvalidateRect(
        g_list,
        nullptr,
        FALSE
    );

    if (selectedPid != 0)
    {
        int selectedRow =
            find_row(selectedPid);

        if (selectedRow >= 0)
        {
            LVITEMW state{};

            state.stateMask =
                LVIS_SELECTED |
                LVIS_FOCUSED;

            state.state =
                LVIS_SELECTED |
                LVIS_FOCUSED;

            SendMessageW(
                g_list,
                LVM_SETITEMSTATE,
                static_cast<WPARAM>(
                    selectedRow
                ),
                reinterpret_cast<LPARAM>(
                    &state
                )
            );

            SendMessageW(
                g_list,
                LVM_ENSUREVISIBLE,
                static_cast<WPARAM>(
                    selectedRow
                ),
                FALSE
            );
        }
    }
}

