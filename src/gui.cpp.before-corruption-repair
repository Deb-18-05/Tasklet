static int list_count()
{
    return static_cast<int>(
        SendMessageW(
            g_list,
            LVM_GETITEMCOUNT,
            0,
            0
        )
    );
}

static void list_set_text(
    int row,
    int column,
    const std::wstring& text
)
{
    LVITEMW item{};

    item.iSubItem = column;
    item.pszText =
        const_cast<LPWSTR>(
            text.c_str()
        );

    SendMessageW(
        g_list,
        LVM_SETITEMTEXTW,
        static_cast<WPARAM>(row),
        reinterpret_cast<LPARAM>(&item)
    );
}

static int list_insert(
    int row,
    const std::wstring& text
)
{
    LVITEMW item{};

    item.mask = LVIF_TEXT;
    item.iItem = row;
    item.iSubItem = 0;
    item.pszText =
        const_cast<LPWSTR>(
            text.c_str()
        );

    return static_cast<int>(
        SendMessageW(
            g_list,
            LVM_INSERTITEMW,
            0,
            reinterpret_cast<LPARAM>(&item)
        )
    );
}

static void list_insert_column(
    int index,
    const wchar_t* title,
    int width
)
{
    LVCOLUMNW column{};

    column.mask =
        LVCF_TEXT |
        LVCF_WIDTH |
        LVCF_SUBITEM;

    column.cx = width;
    column.iSubItem = index;
    column.pszText =
        const_cast<LPWSTR>(title);

    SendMessageW(
        g_list,
        LVM_INSERTCOLUMNW,
        static_cast<WPARAM>(index),
        reinterpret_cast<LPARAM>(&column)
    );
}

static uint32_t list_get_pid(
    int row
)
{
    wchar_t buffer[64]{};

    LVITEMW item{};

    item.iSubItem = 1;
    item.pszText = buffer;
    item.cchTextMax = 64;

    SendMessageW(
        g_list,
        LVM_GETITEMTEXTW,
        static_cast<WPARAM>(row),
        reinterpret_cast<LPARAM>(&item)
    );

    return static_cast<uint32_t>(
        wcstoul(
            buffer,
            nullptr,
            10
        )
    );
}

static int find_row(
    uint32_t pid
)
{
    auto it = g_rows.find(pid);

    if (it == g_rows.end())
        return -1;

    return it->second;
}

// ============================================================
// UPDATE ONE ROW
// ============================================================

static void update_row(
    int row,
    const ProcessInfo& p
)
{
    list_set_text(
        row,
        0,
        to_wide(p.name)
    );

    list_set_text(
        row,
        1,
        std::to_wstring(p.pid)
    );

    list_set_text(
        row,
        2,
        std::to_wstring(p.parent_pid)
    );

    list_set_text(
        row,
        3,
        format_cpu(p.cpu_percent)
    );

    list_set_text(
        row,
        4,
        format_memory(p.memory_bytes)
    );

    list_set_text(
        row,
        5,
        to_wide(p.state)
    );
}

