// ============================================================
// STRING HELPERS
// ============================================================

static std::wstring to_wide(const std::string& text)
{
    if (text.empty())
        return L"";

    int needed = MultiByteToWideChar(
        CP_UTF8,
        0,
        text.c_str(),
        -1,
        nullptr,
        0
    );

    if (needed <= 0)
        return L"";

    std::wstring result(
        static_cast<size_t>(needed - 1),
        L'\0'
    );

    MultiByteToWideChar(
        CP_UTF8,
        0,
        text.c_str(),
        -1,
        result.data(),
        needed
    );

    return result;
}

static std::wstring lower_copy(
    std::wstring value
)
{
    std::transform(
        value.begin(),
        value.end(),
        value.begin(),
        [](wchar_t c)
        {
            return static_cast<wchar_t>(
                towlower(c)
            );
        }
    );

    return value;
}

static bool matches_search(
    const ProcessInfo& process,
    const std::wstring& query
)
{
    if (query.empty())
        return true;

    std::wstring name =
        lower_copy(
            to_wide(process.name)
        );

    std::wstring q =
        lower_copy(query);

    return name.find(q) !=
           std::wstring::npos;
}

static std::wstring get_search_text()
{
    if (!g_search)
        return L"";

    int length =
        GetWindowTextLengthW(g_search);

    if (length <= 0)
        return L"";

    std::wstring result(
        static_cast<size_t>(length),
        L'\0'
    );

    GetWindowTextW(
        g_search,
        result.data(),
        length + 1
    );

    return result;
}

// ============================================================
// FORMATTING
// ============================================================

static std::wstring format_memory(
    uint64_t bytes
)
{
    wchar_t buffer[64]{};

    if (bytes >=
        1024ULL * 1024ULL * 1024ULL)
    {
        swprintf_s(
            buffer,
            L"%.1f GB",
            static_cast<double>(bytes) /
            (1024.0 * 1024.0 * 1024.0)
        );
    }
    else if (bytes >=
             1024ULL * 1024ULL)
    {
        swprintf_s(
            buffer,
            L"%.1f MB",
            static_cast<double>(bytes) /
            (1024.0 * 1024.0)
        );
    }
    else if (bytes >= 1024ULL)
    {
        swprintf_s(
            buffer,
            L"%.1f KB",
            static_cast<double>(bytes) /
            1024.0
        );
    }
    else
    {
        swprintf_s(
            buffer,
            L"%llu B",
            static_cast<unsigned long long>(
                bytes
            )
        );
    }

    return buffer;
}

static std::wstring format_cpu(
    double cpu
)
{
    wchar_t buffer[64]{};

    swprintf_s(
        buffer,
        L"%.1f%%",
        cpu
    );

    return buffer;
}

