// ============================================================
// IN-PLACE TELEMETRY REFRESH
//
// This is the important part.
//
// Existing rows remain exactly where they are.
// We only change cell text.
//
// Therefore:
//   scrollbar = stable
//   scroll position = stable
//   selection = stable
//   mouse position = stable
// ============================================================

static void refresh_processes()
{
    uint32_t selectedPid =
        get_selected_pid();

    std::vector<ProcessInfo> fresh =
        enumerate_processes();

    std::unordered_map<uint32_t, bool>
        freshPids;

    for (const auto& process : fresh)
        freshPids[process.pid] = true;

    // --------------------------------------------------------
    // Determine whether process membership changed.
    // --------------------------------------------------------

    bool membershipChanged =
        freshPids.size() !=
        g_rows.size();

    if (!membershipChanged)
    {
        for (const auto& process : fresh)
        {
            if (g_rows.find(process.pid) ==
                g_rows.end())
            {
                membershipChanged = true;
                break;
            }
        }
    }

    // --------------------------------------------------------
    // If processes appeared/disappeared, update membership.
    // Do NOT rebuild the entire table.
    // --------------------------------------------------------

    if (membershipChanged)
    {
        // Remove dead processes.
        for (int row =
             list_count() - 1;
             row >= 0;
             --row)
        {
            uint32_t pid =
                list_get_pid(row);

            if (freshPids.find(pid) ==
                freshPids.end())
            {
                SendMessageW(
                    g_list,
                    LVM_DELETEITEM,
                    static_cast<WPARAM>(row),
                    0
                );
            }
        }

        // Re-index existing rows.
        g_rows.clear();

        for (int row = 0;
             row < list_count();
             ++row)
        {
            g_rows[
                list_get_pid(row)
            ] = row;
        }

        // Add new processes at the bottom.
        for (const auto& process : fresh)
        {
            if (g_rows.find(process.pid) !=
                g_rows.end())
            {
                continue;
            }

            int row =
                list_insert(
                    list_count(),
                    to_wide(process.name)
                );

            if (row < 0)
                continue;

            update_row(
                row,
                process
            );

            g_rows[process.pid] =
                row;
        }

        // Re-index once more after additions.
        g_rows.clear();

        for (int row = 0;
             row < list_count();
             ++row)
        {
            g_rows[
                list_get_pid(row)
            ] = row;
        }
    }

    // --------------------------------------------------------
    // Update existing rows IN PLACE.
    // --------------------------------------------------------

    for (const auto& process : fresh)
    {
        int row =
            find_row(process.pid);

        if (row < 0)
            continue;

        if (!matches_search(
                process,
                get_search_text()))
        {
            continue;
        }

        update_row(
            row,
            process
        );
    }

    // --------------------------------------------------------
    // If search changed, rebuild filtered membership once.
    // --------------------------------------------------------

    std::wstring currentSearch =
        get_search_text();

    if (currentSearch !=
        g_previous_search)
    {
        g_previous_search =
            currentSearch;

        g_processes =
            std::move(fresh);

        rebuild_filtered_view();
    }
    else
    {
        g_processes =
            std::move(fresh);
    }

    // Restore selected process.
    if (selectedPid != 0)
    {
        int row =
            find_row(selectedPid);

        if (row >= 0)
        {
            LVITEMW state{};

            state.stateMask =
                LVIS_SELECTED |
                LVIS_FOCUSED;

            state.state =
                LVIS_SELECTED |
                LVIS_FOCUSED;

            SendMessageW(
                g_list,
                LVM_SETITEMSTATE,
                static_cast<WPARAM>(row),
                reinterpret_cast<LPARAM>(
                    &state
                )
            );
        }
    }

    wchar_t status[256]{};

    swprintf_s(
        status,
        L"%zu processes    |    "
        L"Live update: 1 s    |    "
        L"Native Tasklet engine",
        g_processes.size()
    );

    SetWindowTextW(
        g_status,
        status
    );
}

// ============================================================
// END PROCESS
// ============================================================

static void end_selected_process(
    HWND owner
)
{
    uint32_t pid =
        get_selected_pid();

    if (pid == 0)
        return;

    if (pid == GetCurrentProcessId())
    {
        MessageBoxW(
            owner,
            L"Tasklet cannot terminate itself.",
            L"Tasklet",
            MB_OK |
            MB_ICONINFORMATION
        );

        return;
    }

    int answer =
        MessageBoxW(
            owner,
            L"Terminate the selected process?",
            L"End Process",
            MB_YESNO |
            MB_ICONWARNING
        );

    if (answer != IDYES)
        return;

    if (!terminate_process(pid))
    {
        MessageBoxW(
            owner,
            L"Tasklet could not terminate the process.",
            L"End Process",
            MB_OK |
            MB_ICONERROR
        );

        return;
    }

    refresh_processes();
}

